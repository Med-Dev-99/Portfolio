---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { site } from '../data/profile';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = site.title, description = site.description, image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Agadir', addressCountry: 'MA' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Ibn Zohr University' },
  sameAs: [site.linkedin, site.github],
  knowsAbout: ['Data Engineering', 'Apache NiFi', 'Apache Spark', 'Azure Databricks', 'Apache Airflow', 'dbt', 'PostgreSQL', 'PostGIS', 'LLM agents'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f6f7f9" />
    <meta name="color-scheme" content="dark light" />

    <script is:inline src="/theme.js"></script>

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <!-- ?v= changes whenever the icon changes, so browsers and the CDN don't keep a stale one. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-primary-ink">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {site.gaId && <Consent />}
  </body>
</html>

<style is:global>
  /* Native cross-document page transitions: no router, no JavaScript. */
  @view-transition { navigation: auto; }
</style>
