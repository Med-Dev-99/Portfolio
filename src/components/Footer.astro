---
import { execSync } from 'node:child_process';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/profile';

let commit = 'local';
try { commit = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch {}
const built = new Date().toISOString().slice(0, 10);
---

<footer class="border-t border-line">
  <div class="wrap flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <Logo class="size-7" />
      <div class="text-sm">
        <p class="m-0 font-medium">{site.name}</p>
        <p class="m-0 font-mono text-[11.5px] text-muted">build {built} · {commit} · Astro + Tailwind on a self-managed VPS</p>
      </div>
    </div>
    <ul class="m-0 flex list-none items-center gap-2 p-0">
      <li><a href={site.github} class="grid size-9 place-items-center rounded-[10px] border border-line bg-surface text-fg-2 transition-colors hover:text-fg" aria-label="GitHub" rel="me noopener" target="_blank"><Icon name="github" class="size-4" /></a></li>
      <li><a href={site.linkedin} class="grid size-9 place-items-center rounded-[10px] border border-line bg-surface text-fg-2 transition-colors hover:text-fg" aria-label="LinkedIn" rel="me noopener" target="_blank"><Icon name="linkedin" class="size-4" /></a></li>
      <li><a href={`mailto:${site.email}`} class="grid size-9 place-items-center rounded-[10px] border border-line bg-surface text-fg-2 transition-colors hover:text-fg" aria-label="Email"><Icon name="mail" class="size-4" /></a></li>
    </ul>
  </div>
</footer>
