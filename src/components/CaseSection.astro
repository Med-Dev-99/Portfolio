---
interface Props { label: string; title: string; id?: string }
const { label, title, id } = Astro.props;
---

<section id={id} class="border-t border-line py-16 sm:py-24">
  <div class="wrap grid gap-8 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="m-0 font-mono text-[12.5px] text-primary">{label}</p>
      <h2 class="mt-3 text-[clamp(28px,3.4vw,40px)]">{title}</h2>
    </div>
    <div class="min-w-0" data-reveal>
      <slot />
    </div>
  </div>
</section>
