---
/** Brand mark: a tiny DAG (one source fanning out to two sinks). */
interface Props { class?: string }
const { class: className = 'size-8' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect x=".75" y=".75" width="30.5" height="30.5" rx="8.5" class="fill-surface stroke-line-strong" stroke-width="1.5" />
  <path d="M10.5 16c4.5 0 4.5-6 9-6M10.5 16c4.5 0 4.5 6 9 6" class="stroke-fg-2" stroke-width="1.6" stroke-linecap="round" />
  <circle cx="9" cy="16" r="3.2" class="fill-primary" />
  <circle cx="22" cy="10" r="3.2" class="fill-cyan" />
  <circle cx="22" cy="22" r="3.2" class="fill-violet" />
</svg>
