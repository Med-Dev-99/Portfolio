---
/**
 * The Freshtrack systems as one tabbed explorer: a list of systems, and for the selected one
 * what it does, what makes it hard, and an illustrative sample of raw signals becoming events.
 * Without JavaScript the tab list is hidden and every system is shown one after another.
 * Sample lines replay like a log each time a system is selected.
 */
import Icon from './Icon.astro';
import { freshtrack } from '../data/profile';

const { systems } = freshtrack;
const total = String(systems.length).padStart(2, '0');
const num = (i: number) => String(i + 1).padStart(2, '0');
const sym = { in: '›', out: '→', drop: '✕', alert: '!', ai: '✦' } as const;
const legend = { in: 'raw signal', out: 'event / output', drop: 'rejected or held', alert: 'risk or alert', ai: 'AI' } as const;
---

<div class="sx card overflow-hidden" data-sx>
  <div class="sx-grid grid">
    <div class="sx-tabs flex gap-1 overflow-x-auto border-b border-line bg-surface-2/60 p-2 [scrollbar-width:none] lg:flex-col lg:overflow-visible lg:border-b-0 lg:border-r lg:p-3" role="tablist" aria-label="Freshtrack systems" data-sx-tabs>
      {systems.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`sx-tab-${s.id}`}
          aria-controls={`sx-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="sx-tab group flex shrink-0 items-center gap-3 rounded-xl px-3 py-2.5 text-left"
        >
          <span class="sx-ico grid size-9 shrink-0 place-items-center rounded-lg border border-line bg-surface text-fg-2"><Icon name={s.icon} class="size-[18px]" /></span>
          <span class="min-w-0">
            <span class="flex items-baseline gap-2">
              <span class="font-mono text-[11px] text-muted">{num(i)}</span>
              <span class="sx-name whitespace-nowrap text-[14.5px] font-medium leading-tight text-fg-2 lg:whitespace-normal">{s.name}</span>
            </span>
            <span class="mt-0.5 hidden font-mono text-[11px] leading-tight text-muted lg:block">{s.tag}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="sx-panels">
      {systems.map((s, i) => (
        <section id={`sx-${s.id}`} role="tabpanel" aria-labelledby={`sx-tab-${s.id}`} class:list={['sx-panel p-6 sm:p-8 lg:p-10', i === 0 && 'is-active']}>
          <p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11.5px] text-muted">
            <span class="text-primary">system {num(i)} / {total}</span><span aria-hidden="true">·</span><span>{s.tag}</span>
          </p>
          <h3 class="mt-3 text-[clamp(24px,2.6vw,32px)] tracking-[-.035em]">{s.name}</h3>
          <p class="m-0 mt-2 text-[clamp(17px,1.7vw,19px)] leading-snug text-fg">{s.value}</p>

          <div class="mt-6 grid gap-7 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] xl:gap-8">
            <div>
              <p class="m-0 text-[15px] leading-relaxed text-fg-2">{s.body}</p>
              <p class="label m-0 mt-6">what makes it hard</p>
              <ul class="m-0 mt-3 grid list-none gap-2.5 p-0">
                {s.hard.map((h) => (
                  <li class="flex gap-3 text-[14.5px] leading-snug text-fg-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-green" /><span>{h}</span></li>
                ))}
              </ul>
            </div>

            <figure class="sx-log m-0 self-start overflow-hidden rounded-xl border border-line bg-bg-2">
              <figcaption class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 font-mono text-[11.5px]">
                <span class="text-fg">{s.id}<span class="text-muted">.log</span></span>
                <span class="rounded border border-line px-1.5 py-px text-[10px] uppercase tracking-wider text-muted">illustrative sample</span>
              </figcaption>
              <ol class="m-0 grid list-none gap-1.5 p-4 font-mono text-[12px] leading-snug">
                {s.sample.map((l, j) => (
                  <li class:list={['sx-line grid grid-cols-[12px_58px_minmax(0,1fr)] gap-x-2', `k-${l.k}`]} style={`--i:${j}`} title={legend[l.k]}>
                    <span class="sx-sym" aria-hidden="true">{sym[l.k]}</span>
                    <span class="sx-tag truncate text-muted">{l.tag}</span>
                    <span class="sx-text">{l.text}</span>
                  </li>
                ))}
                <li class="sx-cursor" style={`--i:${s.sample.length}`} aria-hidden="true"><span></span></li>
              </ol>
            </figure>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-2 border-t border-line pt-5">
            {s.facts.map((f) => <span class="rounded-md border border-primary/25 bg-primary/8 px-2 py-1 font-mono text-[11.5px] text-primary">{f}</span>)}
            <span class="mx-1 hidden h-4 w-px bg-line sm:inline-block" aria-hidden="true"></span>
            {s.stack.map((t) => <span class="tag">{t}</span>)}
            {s.link && <a href={s.link.href} class="link ml-auto text-[14px]">{s.link.label} <Icon name="arrow-right" class="size-4" /></a>}
          </div>
        </section>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* Tabs */
  .sx .sx-tab { transition: background-color .2s, box-shadow .2s; }
  .sx .sx-tab:hover { background: var(--surface); }
  .sx .sx-tab[aria-selected='true'] { background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), var(--shadow); }
  .sx .sx-tab[aria-selected='true'] .sx-name { color: var(--text); }
  .sx .sx-tab[aria-selected='true'] .sx-ico { color: var(--primary-ink); background: linear-gradient(135deg, var(--primary), var(--violet)); border-color: transparent; }
  .sx .sx-tab:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

  /* Without JS: no tabs, every system shown in turn. */
  html:not(.js) .sx .sx-tabs { display: none; }
  html:not(.js) .sx .sx-panel + .sx-panel { border-top: 1px solid var(--line); }

  /* With JS: one system at a time. On wide screens all panels share one grid cell, so the
     card keeps the height of the tallest one and nothing jumps when switching. */
  .js .sx .sx-panel:not(.is-active) { display: none; }
  @media (min-width: 1024px) {
    .js .sx .sx-grid { grid-template-columns: 300px minmax(0, 1fr); }
    .js .sx .sx-panels { display: grid; }
    .js .sx .sx-panel { grid-area: 1 / 1; }
    .js .sx .sx-panel:not(.is-active) { display: block; visibility: hidden; }
  }

  /* Sample log */
  .sx .sx-sym { font-weight: 700; text-align: center; }
  .sx .k-in .sx-sym { color: var(--cyan); }
  .sx .k-in .sx-text { color: var(--text-2); }
  .sx .k-out .sx-sym { color: var(--green); }
  .sx .k-out .sx-text { color: var(--text); }
  .sx .k-drop .sx-sym, .sx .k-drop .sx-text { color: var(--red); }
  .sx .k-alert .sx-sym, .sx .k-alert .sx-text { color: var(--amber); }
  .sx .k-ai .sx-sym, .sx .k-ai .sx-text { color: var(--violet); }
  .sx .sx-cursor span { display: inline-block; width: 7px; height: 13px; margin-left: 2px; background: var(--primary); vertical-align: -2px; animation: sx-blink 1.1s steps(1) infinite; }

  .sx .sx-panel.is-active .sx-line,
  .sx .sx-panel.is-active .sx-cursor { animation: sx-in .38s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 160ms + 120ms); }
  .sx .sx-panel.is-active .sx-cursor span { animation: sx-blink 1.1s steps(1) infinite; }
  @keyframes sx-in { from { opacity: 0; transform: translateX(-6px); } }
  @keyframes sx-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .sx .sx-panel.is-active .sx-line, .sx .sx-panel.is-active .sx-cursor { animation: none; }
    .sx .sx-cursor span { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-sx]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-sx-tabs]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].classList.toggle('is-active', on);
      });
      if (focus) tabs[i].focus({ preventScroll: true });
      // On phones the tabs scroll sideways: bring the selected one into view without moving the page.
      if (list.scrollWidth > list.clientWidth) {
        const t = tabs[i];
        list.scrollTo({ left: t.offsetLeft - (list.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const next = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: n - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((next + n) % n, true);
      });
    });
  });
</script>
