---
/**
 * Architecture map: a data platform drawn the way it is built, layer by layer
 * (sources → ingest → process → store → serve), with selectable flows.
 *
 * - Selecting a flow lights up its path and dims the rest. While the map is on screen it steps
 *   through the flows by itself until someone interacts (never with reduced motion or on phones).
 * - Hovering or focusing a component shows what it does and lights up every flow that uses it.
 * - Wide screens get the SVG diagram with its caption underneath; phones get the caption, then the
 *   selected flow as a vertical pipeline.
 * - Without JavaScript: the full diagram with native tooltips, and every flow's caption.
 */
import type { ArchMap, ArchNode, ArchGlyph } from '../data/profile';

interface Props { map: ArchMap }
const { map } = Astro.props;

// 16×16 stroke glyphs.
const glyphs: Record<ArchGlyph, string> = {
  ship: '<path d="M2 10h12l-2 3.5H4zM4.5 6.5h3v3.5h-3zM8.5 6.5h3v3.5h-3z"/>',
  signal: '<circle cx="8" cy="9.2" r="1.3"/><path d="M5.3 6.5a3.8 3.8 0 0 1 5.4 0M3.2 4.4a6.8 6.8 0 0 1 9.6 0M8 10.5v3.5"/>',
  pin: '<path d="M8 14.5s4.5-4.2 4.5-7.8a4.5 4.5 0 1 0-9 0C3.5 10.3 8 14.5 8 14.5z"/><circle cx="8" cy="6.6" r="1.6"/>',
  mail: '<rect x="1.5" y="3.5" width="13" height="9" rx="1.5"/><path d="m2 4.5 6 4.5 6-4.5"/>',
  globe: '<circle cx="8" cy="8" r="6.2"/><path d="M1.8 8h12.4M8 1.8c2 2.2 2 10.2 0 12.4M8 1.8c-2 2.2-2 10.2 0 12.4"/>',
  merge: '<path d="M2 3.5h3.5L9 8h5M2 12.5h3.5L9 8M2 8h7"/><path d="m12 6 2 2-2 2"/>',
  workflow: '<rect x="1.5" y="2" width="4.5" height="4.5" rx="1"/><rect x="10" y="9.5" width="4.5" height="4.5" rx="1"/><path d="M3.75 6.5V9a2.5 2.5 0 0 0 2.5 2.5H10"/>',
  browser: '<rect x="1.5" y="2.5" width="13" height="11" rx="1.5"/><path d="M1.5 5.5h13M4 4h.01M6 4h.01"/>',
  layers: '<path d="M8 1.8 14.2 5 8 8.2 1.8 5z"/><path d="m1.8 8 6.2 3.2L14.2 8M1.8 11l6.2 3.2 6.2-3.2"/>',
  geofence: '<path d="M2.5 4.5 7 2l6.5 3-1 6.5L7 14l-4.5-3z"/><circle cx="7.6" cy="7.6" r="1.5"/>',
  columns: '<path d="M2 13.5h12"/><rect x="3" y="7" width="2.5" height="6.5" rx=".5"/><rect x="6.75" y="3" width="2.5" height="10.5" rx=".5"/><rect x="10.5" y="5" width="2.5" height="8.5" rx=".5"/>',
  scan: '<path d="M2 5V3.5A1.5 1.5 0 0 1 3.5 2H5M11 2h1.5A1.5 1.5 0 0 1 14 3.5V5M14 11v1.5a1.5 1.5 0 0 1-1.5 1.5H11M5 14H3.5A1.5 1.5 0 0 1 2 12.5V11"/><path d="M5 6h6M5 8.5h6M5 11h3.5"/>',
  shuffle: '<path d="M2 4.5h2.5c3 0 4 7 7 7H14M2 11.5h2.5c1.2 0 2-.9 2.7-2M14 4.5h-2.5c-1.2 0-2 .9-2.7 2"/><path d="m12.5 3 1.5 1.5-1.5 1.5M12.5 10l1.5 1.5-1.5 1.5"/>',
  database: '<ellipse cx="8" cy="3.8" rx="5.5" ry="2"/><path d="M2.5 3.8v8.4c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2V3.8M2.5 8c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2"/>',
  bolt: '<path d="M9 1.5 3.5 9H8l-1 5.5L12.5 7H8z"/>',
  bell: '<path d="M4 11.5V7.2a4 4 0 0 1 8 0v4.3l1.2 1.3H2.8z"/><path d="M6.6 14.3a1.6 1.6 0 0 0 2.8 0"/>',
  chart: '<path d="M2 2v12h12"/><path d="M5 10.5V8M8 10.5V5M11 10.5V7"/>',
  code: '<path d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5M9 3 7 13"/>',
  satellite: '<path d="M1 6.5h4v3H1zM11 6.5h4v3h-4zM6 5.5h4v5H6zM8 5.5V3M6.5 2.5h3"/>',
  download: '<path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 12.5v1h11v-1"/>',
  server: '<rect x="2" y="2.5" width="12" height="4.5" rx="1"/><rect x="2" y="9" width="12" height="4.5" rx="1"/><path d="M4.5 4.75h.01M4.5 11.25h.01"/>',
  spark: '<path d="M8 1.8l1.6 4.6 4.6 1.6-4.6 1.6L8 14.2l-1.6-4.6L1.8 8l4.6-1.6z"/>',
  monitor: '<rect x="1.5" y="2.5" width="13" height="8.5" rx="1.2"/><path d="M5.5 13.5h5M8 11v2.5"/>',
  gear: '<circle cx="8" cy="8" r="2.3"/><path d="M8 1.6v2.1M8 12.3v2.1M1.6 8h2.1M12.3 8h2.1M3.5 3.5 5 5M11 11l1.5 1.5M3.5 12.5 5 11M11 5l1.5-1.5"/>',
  cloud: '<path d="M4.6 12.6h6.9a3 3 0 0 0 .3-6 4.1 4.1 0 0 0-7.8 1.1 2.5 2.5 0 0 0 .6 4.9z"/>',
  drop: '<path d="M8 1.8s4.6 5 4.6 8.3a4.6 4.6 0 0 1-9.2 0C3.4 6.8 8 1.8 8 1.8z"/>',
};

// ---- geometry (SVG user units) ----
const W = 1160, PAD = 8, TOP = 52, NODE_H = 54, ROW = 76;
const cols = map.layers.length;
const colW = (W - PAD * 2) / cols;
const nodeW = Math.round(Math.min(184, colW - 30));
const r1 = (n: number) => Math.round(n * 10) / 10;
const cx = (layer: number) => PAD + colW * layer + colW / 2;
const cy = (row: number) => TOP + row * ROW + NODE_H / 2;
const maxRow = Math.max(...map.nodes.map((n) => n.row));
const nodesBottom = TOP + maxRow * ROW + NODE_H;
const laneY = nodesBottom + 20;
const H = map.lane ? laneY + 34 + 10 : nodesBottom + 14;

// ---- which flows use each edge and node ----
const byId = new Map(map.nodes.map((n) => [n.id, n] as const));
const flowsOfEdge = new Map<string, string[]>();
const flowsOfNode = new Map<string, string[]>();
for (const f of map.flows) {
  for (const e of f.edges) {
    flowsOfEdge.set(e, [...(flowsOfEdge.get(e) ?? []), f.id]);
    for (const id of e.split('>')) {
      if (!byId.has(id)) throw new Error(`ArchMap ${map.id}: unknown node "${id}" in edge "${e}"`);
      const list = flowsOfNode.get(id) ?? [];
      if (!list.includes(f.id)) list.push(f.id);
      flowsOfNode.set(id, list);
    }
  }
}
const edges = [...flowsOfEdge].map(([key, flows]) => {
  const [a, b] = key.split('>').map((id) => byId.get(id)!);
  const x1 = cx(a.layer) + nodeW / 2, y1 = cy(a.row);
  const x2 = cx(b.layer) - nodeW / 2, y2 = cy(b.row);
  const m = (x1 + x2) / 2;
  return { key, flows: flows.join(' '), d: `M${r1(x1)} ${r1(y1)}C${r1(m)} ${r1(y1)} ${r1(m)} ${r1(y2)} ${r1(x2)} ${r1(y2)}`, x2: r1(x2), y2: r1(y2) };
});

// ---- phone view: a flow's nodes grouped by layer ----
const pathOf = (edgesOfFlow: string[]) => {
  const ids = [...new Set(edgesOfFlow.flatMap((e) => e.split('>')))];
  const nodes = ids.map((id) => byId.get(id)!).sort((a, b) => a.layer - b.layer || a.row - b.row);
  const groups: { layer: number; nodes: ArchNode[] }[] = [];
  for (const n of nodes) {
    const last = groups.at(-1);
    if (last && last.layer === n.layer) last.nodes.push(n);
    else groups.push({ layer: n.layer, nodes: [n] });
  }
  return groups;
};
const num = (i: number) => String(i + 1).padStart(2, '0');
const tone = (layer: number) => `tone-${map.layers[layer].tone}`;
---

<div class="am flex flex-col gap-5" data-am={map.id}>
  <div class="am-chips flex flex-wrap gap-2" role="group" aria-label={`${map.title}: highlight one flow`}>
    <button type="button" class="am-chip am-all" data-flow="" aria-pressed="true">All</button>
    {map.flows.map((f) => <button type="button" class="am-chip" data-flow={f.id} aria-pressed="false">{f.name}</button>)}
  </div>

  <div class="am-caps order-1 min-[900px]:order-3">
    <p class="am-cap is-active m-0 text-[15px] leading-relaxed text-fg-2" data-cap="">{map.intro}</p>
    {map.flows.map((f) => (
      <div class="am-cap" data-cap={f.id}>
        <p class="m-0 text-[15px] leading-relaxed text-fg-2"><b class="font-semibold text-fg">{f.name}.</b> {f.summary}</p>
        <p class="m-0 mt-2.5 flex flex-wrap items-center gap-1.5">
          {f.facts.map((t) => <span class="rounded-md border border-primary/25 bg-primary/8 px-2 py-0.5 font-mono text-[11.5px] text-primary">{t}</span>)}
          {f.link && <a href={f.link.href} class="link ml-1 text-[13.5px]">{f.link.label} →</a>}
        </p>
      </div>
    ))}
  </div>

  <!-- Wide screens: the diagram -->
  <div class="am-stage relative order-2 hidden min-[900px]:block">
    <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" role="group" aria-label={map.title}>
      <g aria-hidden="true">
        {map.layers.map((l, i) => (
          <g class={`tone-${l.tone}`}>
            <rect x={r1(PAD + colW * i + 4)} y="0" width={r1(colW - 8)} height={H} rx="14" class:list={['am-band', i % 2 === 1 && 'am-band-alt']} />
            <circle cx={r1(cx(i) - (l.name.length * 3.9 + 26))} cy="25" r="3" class="am-head-dot" />
            <text x={r1(cx(i))} y="29" text-anchor="middle" class="am-head" font-size="10.5">{num(i)} · {l.name.toUpperCase()}</text>
          </g>
        ))}
      </g>

      <g aria-hidden="true">
        {edges.map((e) => (
          <g class="am-edge" data-flows={e.flows}>
            <path d={e.d} class="am-base" />
            <path d={e.d} class="am-flow" />
            <circle cx={e.x2} cy={e.y2} r="3" class="am-end" />
          </g>
        ))}
      </g>

      {map.nodes.map((n) => {
        const x = r1(cx(n.layer) - nodeW / 2), y = r1(cy(n.row) - NODE_H / 2);
        return (
          <g class:list={['am-node', tone(n.layer)]} data-flows={(flowsOfNode.get(n.id) ?? []).join(' ')} data-label={n.label} data-detail={n.detail} tabindex="0" aria-label={`${n.label}: ${n.detail}`}>
            <title>{n.label}: {n.detail}</title>
            <rect x={x} y={y} width={nodeW} height={NODE_H} rx="12" class="am-box" />
            <rect x={r1(x + 10)} y={r1(y + 13)} width="28" height="28" rx="8" class="am-ico" />
            <g transform={`translate(${r1(x + 16)} ${r1(y + 19)})`} class="am-glyph" set:html={glyphs[n.icon]} />
            <text x={r1(x + 48)} y={r1(y + 24)} class="am-label" font-size="13">{n.label}</text>
            <text x={r1(x + 48)} y={r1(y + 40)} class="am-sub" font-size="10">{n.sub}</text>
          </g>
        );
      })}

      {map.lane && (
        <g class="am-lane" aria-hidden="true">
          <rect x={r1(cx(map.lane.from) - nodeW / 2)} y={laneY} width={r1(cx(map.lane.to) - cx(map.lane.from) + nodeW)} height="34" rx="10" />
          <text x={r1(cx(map.lane.from) - nodeW / 2 + 16)} y={laneY + 21} class="am-lane-label" font-size="10.5">{map.lane.label.toUpperCase()}</text>
          <text x={r1(cx(map.lane.from) - nodeW / 2 + 28 + map.lane.label.length * 8.4)} y={laneY + 21} class="am-lane-text" font-size="11.5">{map.lane.text}</text>
        </g>
      )}
    </svg>
    <div class="am-tip" role="tooltip" hidden><b></b><span></span></div>
  </div>

  <!-- Phones: the selected flow as a vertical pipeline -->
  <div class="am-paths order-2 min-[900px]:hidden">
    {map.flows.map((f, i) => (
      <div class:list={['am-path', i === 0 && 'is-active']} data-path={f.id}>
        <p class="am-path-title m-0 mb-3 font-semibold">{f.name}</p>
        <ol class="m-0 list-none p-0">
          {pathOf(f.edges).map((g) => (
            <li class="am-step">
              <p class="m-0 mb-1.5 font-mono text-[10.5px] uppercase tracking-[.14em] text-muted">{num(g.layer)} · {map.layers[g.layer].name}</p>
              <div class="flex flex-wrap gap-2">
                {g.nodes.map((n) => (
                  <div class:list={['am-pnode flex min-w-0 flex-1 items-center gap-2.5 rounded-xl border border-line bg-surface px-3 py-2', tone(n.layer)]}>
                    <span class="am-pico grid size-8 shrink-0 place-items-center rounded-lg">
                      <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true" set:html={glyphs[n.icon]} />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[14px] font-semibold leading-tight text-fg">{n.label}</span>
                      <span class="block font-mono text-[11px] leading-tight text-muted">{n.sub}</span>
                    </span>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}
    {map.lane && <p class="m-0 mt-4 rounded-lg border border-dashed border-line px-3 py-2 font-mono text-[11px] text-muted"><span class="text-violet">{map.lane.label}</span> · {map.lane.text}</p>}
  </div>
</div>

<style is:global>
  .am { --am-dur: 4.8s; }
  .am .tone-cyan { --tone: var(--cyan); }
  .am .tone-primary { --tone: var(--primary); }
  .am .tone-violet { --tone: var(--violet); }
  .am .tone-amber { --tone: var(--amber); }
  .am .tone-green { --tone: var(--green); }

  /* Flow chips */
  .am-chip { position: relative; overflow: hidden; border: 1px solid var(--line); background: var(--surface); color: var(--text-2); border-radius: 999px; padding: 6px 13px; font-size: 13.5px; line-height: 1.25; transition: color .2s, background-color .2s, border-color .2s; }
  .am-chip:hover { color: var(--text); border-color: var(--line-strong); }
  .am-chip:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .am-chip[aria-pressed='true'] { color: var(--primary-ink); background: var(--primary); border-color: transparent; }
  .am[data-auto] .am-chip[aria-pressed='true']::after { content: ''; position: absolute; inset: auto 0 0 0; height: 2px; background: color-mix(in srgb, var(--primary-ink) 75%, transparent); transform-origin: left; animation: am-progress var(--am-dur) linear forwards; }
  @keyframes am-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  html:not(.js) .am-chips { display: none; }
  @media (max-width: 899.98px) { .am-chip.am-all { display: none; } }

  /* Captions: with JS one at a time, all stacked in one cell so the height never jumps. */
  .js .am-caps { display: grid; }
  .js .am-cap { grid-area: 1 / 1; visibility: hidden; }
  .js .am-cap.is-active { visibility: visible; }
  html:not(.js) .am-cap + .am-cap { margin-top: 12px; }

  /* Diagram */
  .am-band { fill: var(--surface-2); opacity: .45; }
  .am-band-alt { opacity: .8; }
  .am-head { fill: var(--muted); font-family: var(--font-mono); letter-spacing: .14em; }
  .am-head-dot { fill: var(--tone); }
  .am-base { fill: none; stroke: var(--line-strong); stroke-width: 1.3; transition: stroke .3s; }
  .am-flow { fill: none; stroke: var(--primary); stroke-width: 1.8; stroke-linecap: round; stroke-dasharray: 2 10; opacity: .5; animation: am-dash 1.15s linear infinite; }
  .am-end { fill: var(--line-strong); }
  .am-edge.is-on .am-base { stroke: color-mix(in srgb, var(--primary) 45%, transparent); stroke-width: 2; }
  .am-edge.is-on .am-flow { opacity: 1; stroke-width: 2.6; stroke-dasharray: 3 9; }
  .am-edge.is-on .am-end { fill: var(--primary); }
  .am-box { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.2; transition: stroke .3s, stroke-width .3s; }
  .am-ico { fill: color-mix(in srgb, var(--tone) 12%, var(--surface)); stroke: color-mix(in srgb, var(--tone) 35%, transparent); transition: fill .3s; }
  .am-glyph, .am-pico svg { color: var(--tone); fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .am-label { fill: var(--text); font-family: var(--font-sans); font-weight: 600; }
  .am-sub { fill: var(--muted); font-family: var(--font-mono); }
  .am-node { outline: none; cursor: default; }
  .am-node:focus-visible .am-box { stroke: var(--primary); stroke-width: 2.4; }
  .am-node.is-on .am-box { stroke: var(--tone); stroke-width: 1.8; }
  .am-node.is-on .am-ico { fill: var(--tone); stroke: none; }
  .am-node.is-on .am-glyph { color: var(--surface); }
  .am-node.is-hover .am-box { stroke-width: 2.6; }
  .am-node, .am-edge { transition: opacity .35s ease; }
  .am .is-dim { opacity: .14; }
  .am-lane rect { fill: color-mix(in srgb, var(--violet) 5%, transparent); stroke: color-mix(in srgb, var(--violet) 40%, var(--line)); stroke-dasharray: 4 4; }
  .am-lane-label { fill: var(--violet); font-family: var(--font-mono); letter-spacing: .14em; }
  .am-lane-text { fill: var(--text-2); font-family: var(--font-mono); }
  @keyframes am-dash { to { stroke-dashoffset: -12; } }

  .am-tip { position: absolute; z-index: 5; max-width: 300px; pointer-events: none; border: 1px solid var(--line-strong); background: var(--surface); box-shadow: var(--shadow); border-radius: 10px; padding: 9px 12px; font-size: 13px; line-height: 1.45; color: var(--text-2); }
  .am-tip b { display: block; margin-bottom: 2px; color: var(--text); font-weight: 600; }

  /* Phone pipeline */
  .am-pico { background: color-mix(in srgb, var(--tone) 12%, var(--surface)); border: 1px solid color-mix(in srgb, var(--tone) 35%, transparent); }
  .js .am-path:not(.is-active) { display: none; }
  .js .am-path-title { display: none; }
  html:not(.js) .am-path + .am-path { margin-top: 28px; }
  .am-step { position: relative; }
  .am-step + .am-step { margin-top: 30px; }
  .am-step + .am-step::before { content: ''; position: absolute; left: 27px; top: -26px; width: 2px; height: 20px; background: linear-gradient(var(--primary) 50%, transparent 0) 0 0 / 2px 8px; animation: am-vdash .9s linear infinite; }
  @keyframes am-vdash { to { background-position: 0 8px; } }

  @media (prefers-reduced-motion: reduce) {
    .am-flow, .am-step + .am-step::before { animation: none; }
  }
</style>

<script>
  const DURATION = 4800;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const narrow = matchMedia('(max-width: 899.98px)');

  document.querySelectorAll<HTMLElement>('[data-am]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.am-chip')];
    const caps = [...root.querySelectorAll<HTMLElement>('.am-cap')];
    const paths = [...root.querySelectorAll<HTMLElement>('.am-path')];
    const parts = [...root.querySelectorAll<SVGGElement>('.am-edge, .am-node')];
    const nodes = [...root.querySelectorAll<SVGGElement>('.am-node')];
    const flows = chips.map((c) => c.dataset.flow ?? '').filter(Boolean);
    const stage = root.querySelector<HTMLElement>('.am-stage')!;
    const tip = root.querySelector<HTMLElement>('.am-tip')!;
    // The custom tooltip replaces the native one.
    root.querySelectorAll('.am-node > title').forEach((t) => t.remove());

    let active = '';
    let stopped = false;
    let visible = false;
    let timer = 0;

    const light = (ids: string[] | null, hovered?: Element) => {
      for (const el of parts) {
        const mine = (el.dataset.flows ?? '').split(' ');
        const on = el === hovered || (!!ids && mine.some((f) => ids.includes(f)));
        el.classList.toggle('is-on', on);
        el.classList.toggle('is-dim', !!ids && !on);
        el.classList.toggle('is-hover', el === hovered);
      }
    };

    const select = (id: string) => {
      if (!id && narrow.matches) id = flows[0];
      active = id;
      for (const c of chips) c.setAttribute('aria-pressed', String((c.dataset.flow ?? '') === id));
      for (const c of caps) c.classList.toggle('is-active', (c.dataset.cap ?? '') === id);
      for (const p of paths) p.classList.toggle('is-active', p.dataset.path === (id || flows[0]));
      light(id ? [id] : null);
    };

    const halt = () => { stopped = true; clearTimeout(timer); delete root.dataset.auto; };
    const schedule = () => {
      clearTimeout(timer);
      delete root.dataset.auto;
      if (stopped || !visible || document.hidden || reduce.matches || narrow.matches) return;
      void root.offsetWidth; // restart the progress bar
      root.dataset.auto = '';
      timer = window.setTimeout(() => {
        const order = ['', ...flows];
        select(order[(order.indexOf(active) + 1) % order.length]);
        schedule();
      }, DURATION);
    };

    chips.forEach((chip) => chip.addEventListener('click', () => { halt(); select(chip.dataset.flow ?? ''); }));

    const show = (node: SVGGElement) => {
      halt();
      light((node.dataset.flows ?? '').split(' ').filter(Boolean), node);
      tip.querySelector('b')!.textContent = node.dataset.label ?? '';
      tip.querySelector('span')!.textContent = node.dataset.detail ?? '';
      tip.hidden = false;
      const n = node.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      const left = Math.min(Math.max(n.left - s.left + n.width / 2 - tip.offsetWidth / 2, 4), s.width - tip.offsetWidth - 4);
      let top = n.top - s.top - tip.offsetHeight - 10;
      if (top < 0) top = n.bottom - s.top + 10;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };
    const hide = () => { tip.hidden = true; light(active ? [active] : null); };
    for (const node of nodes) {
      node.addEventListener('pointerenter', () => show(node));
      node.addEventListener('pointerleave', hide);
      node.addEventListener('focus', () => show(node));
      node.addEventListener('blur', hide);
    }

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }, { threshold: 0.35 }).observe(root);
    document.addEventListener('visibilitychange', schedule);
    narrow.addEventListener('change', () => { select(active); schedule(); });
    select('');
  });
</script>
