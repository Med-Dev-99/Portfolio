---
/**
 * The stack as data-platform layers, with lineage: hover (or focus/tap) a tool to trace
 * where it was used; hover a context to see its tools. Lines are drawn on an SVG overlay.
 */
import { stackLayers, contexts, alsoKnow } from '../data/profile';
---

<div class="lineage relative" data-lineage>
  <svg class="pointer-events-none absolute inset-0 z-10 hidden h-full w-full overflow-visible lg:block" data-lines aria-hidden="true"></svg>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-24">
    <ol class="m-0 grid list-none gap-0 p-0">
      {stackLayers.map((layer, i) => (
        <li class="grid gap-3 border-t border-line py-4 first:border-t-0 first:pt-0 sm:grid-cols-[132px_minmax(0,1fr)] sm:gap-6">
          <span class="flex items-center gap-2.5 pt-1">
            <span class="font-mono text-[11px] text-muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-mono text-[13px] font-medium uppercase tracking-[.1em] text-fg">{layer.layer}</span>
          </span>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {layer.tools.map((tool) => (
              <li>
                <button type="button" class="tool" data-tool={tool.name} data-used={tool.used.join(' ')}>
                  {tool.name}
                </button>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div>
      <p class="label m-0 mb-3">Where it was used</p>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0 lg:grid lg:gap-2">
        {contexts.map((c) => (
          <li>
            <button type="button" class="ctx" data-ctx={c.id}>
              <span class="block text-[14.5px] font-medium leading-tight text-fg">{c.name}</span>
              <span class="mt-0.5 block font-mono text-[11px] leading-tight text-muted">{c.kind}{c.period && ` · ${c.period}`}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="mt-8 text-sm text-muted">{alsoKnow}</p>
</div>

<style is:global>
  .lineage .tool {
    display: inline-flex; align-items: center; height: 32px; padding: 0 12px;
    border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
    font-size: 14px; color: var(--text-2); cursor: default;
    transition: border-color .2s, color .2s, background-color .2s, opacity .2s, box-shadow .2s;
  }
  .lineage .ctx {
    display: block; width: 100%; text-align: left; padding: 9px 12px;
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface);
    cursor: default; transition: border-color .2s, background-color .2s, opacity .2s, box-shadow .2s;
  }
  .lineage .tool:hover, .lineage .ctx:hover { border-color: var(--line-strong); }
  /* Active state: highlight the selection and its lineage, dim everything else. */
  .lineage.is-tracing .tool, .lineage.is-tracing .ctx { opacity: .38; }
  .lineage.is-tracing .on { opacity: 1; border-color: color-mix(in srgb, var(--primary) 55%, var(--line)); background: color-mix(in srgb, var(--primary) 7%, var(--surface)); color: var(--text); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent); }
  .lineage .lines-path { fill: none; stroke: var(--primary); stroke-width: 1.4; stroke-dasharray: var(--len); stroke-dashoffset: var(--len); animation: trace .5s cubic-bezier(.2,.7,.2,1) forwards; opacity: .75; }
  .lineage .lines-dot { fill: var(--primary); }
  @keyframes trace { to { stroke-dashoffset: 0; } }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';

  function init(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('[data-lines]')!;
    const tools = [...root.querySelectorAll<HTMLButtonElement>('[data-tool]')];
    const ctxs = [...root.querySelectorAll<HTMLButtonElement>('[data-ctx]')];
    let pinned: HTMLElement | null = null;
    let demo = 0;

    const clear = () => {
      root.classList.remove('is-tracing');
      root.querySelectorAll('.on').forEach((el) => el.classList.remove('on'));
      svg.replaceChildren();
    };

    const link = (a: HTMLElement, b: HTMLElement) => {
      if (!svg.getBoundingClientRect().width) return; // lines only on wide layouts
      const box = root.getBoundingClientRect();
      const ra = a.getBoundingClientRect();
      const rb = b.getBoundingClientRect();
      const x1 = ra.right - box.left, y1 = ra.top + ra.height / 2 - box.top;
      const x2 = rb.left - box.left, y2 = rb.top + rb.height / 2 - box.top;
      const mx = (x1 + x2) / 2;
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', `M${x1} ${y1}C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`);
      path.setAttribute('class', 'lines-path');
      svg.appendChild(path);
      path.style.setProperty('--len', String(path.getTotalLength()));
      for (const [x, y] of [[x1, y1], [x2, y2]]) {
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(y));
        dot.setAttribute('r', '2.6');
        dot.setAttribute('class', 'lines-dot');
        svg.appendChild(dot);
      }
    };

    const traceTool = (tool: HTMLElement) => {
      clear();
      root.classList.add('is-tracing');
      tool.classList.add('on');
      const used = (tool.dataset.used ?? '').split(' ');
      ctxs.filter((c) => used.includes(c.dataset.ctx!)).forEach((c) => { c.classList.add('on'); link(tool, c); });
    };

    const traceCtx = (ctx: HTMLElement) => {
      clear();
      root.classList.add('is-tracing');
      ctx.classList.add('on');
      tools.filter((t) => (t.dataset.used ?? '').split(' ').includes(ctx.dataset.ctx!)).forEach((t) => { t.classList.add('on'); link(t, ctx); });
    };

    const stopDemo = () => { clearTimeout(demo); demo = -1; };
    const bind = (el: HTMLElement, trace: (el: HTMLElement) => void) => {
      el.addEventListener('pointerenter', () => { stopDemo(); if (!pinned) trace(el); });
      el.addEventListener('pointerleave', () => { if (!pinned) clear(); });
      el.addEventListener('focus', () => { stopDemo(); trace(el); });
      el.addEventListener('blur', () => { if (!pinned) clear(); });
      el.addEventListener('click', () => {
        stopDemo();
        if (pinned === el) { pinned = null; clear(); return; }
        pinned = el;
        trace(el);
      });
    };
    tools.forEach((t) => bind(t, traceTool));
    ctxs.forEach((c) => bind(c, traceCtx));
    document.addEventListener('click', (e) => { if (pinned && !root.contains(e.target as Node)) { pinned = null; clear(); } });
    addEventListener('resize', () => { if (pinned) (pinned.dataset.tool ? traceTool : traceCtx)(pinned); });

    // A short demo the first time the section is seen, so visitors discover the interaction.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting || demo === -1) return;
        io.disconnect();
        const seq = ['Parquet · Arrow', 'PostgreSQL', 'LLM agents'];
        let i = 0;
        const next = () => {
          if (demo === -1) return;
          if (i === seq.length) { clear(); return; }
          const t = tools.find((x) => x.dataset.tool === seq[i++]);
          if (t) traceTool(t);
          demo = window.setTimeout(next, 1600);
        };
        demo = window.setTimeout(next, 500);
      }, { threshold: 0.45 });
      io.observe(root);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-lineage]').forEach(init);
</script>
