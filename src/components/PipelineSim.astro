---
/**
 * A live simulation of the Freshtrack data flow.
 * Signals flow from sources → ingest → validate (bad records to quarantine) → unify → enrich → serve
 * → consumers (risk alerts, dashboards, AI insights). Two layouts: wide (desktop) and tall (mobile).
 * The SVG is complete without JavaScript (static diagram + a few parked records); the script animates it.
 */

type Pt = [number, number];
type Box = { id: string; x: number; y: number; w: number; h: number; stage?: string; tools?: string; kind: 'stage' | 'quarantine' };
type Port = { id: string; cx: number; cy: number; label: string; glyph: keyof typeof glyphs; tone: string; lx: number; ly: number; anchor: 'start' | 'middle' | 'end' };
type Edge = { id: string; from: string; to: string; p: [Pt, Pt, Pt, Pt] };
type Layout = { name: 'wide' | 'tall'; w: number; h: number; boxes: Box[]; sources: Port[]; outputs: Port[]; edges: Edge[]; fs: { stage: number; tools: number; port: number } };

const glyphs = {
  ship: '<path d="M2 10h12l-2 3.5H4zM4.5 6.5h3v3.5h-3zM8.5 6.5h3v3.5h-3z"/>',
  pin: '<path d="M8 14.5s4.5-4.2 4.5-7.8a4.5 4.5 0 1 0-9 0C3.5 10.3 8 14.5 8 14.5z"/><circle cx="8" cy="6.6" r="1.6"/>',
  signal: '<circle cx="8" cy="9.2" r="1.3"/><path d="M5.3 6.5a3.8 3.8 0 0 1 5.4 0M3.2 4.4a6.8 6.8 0 0 1 9.6 0M8 10.5v3.5"/>',
  mail: '<rect x="1.5" y="3.5" width="13" height="9" rx="1.5"/><path d="m2 4.5 6 4.5 6-4.5"/>',
  globe: '<circle cx="8" cy="8" r="6.2"/><path d="M1.8 8h12.4M8 1.8c2 2.2 2 10.2 0 12.4M8 1.8c-2 2.2-2 10.2 0 12.4"/>',
  bell: '<path d="M4 11.5V7.2a4 4 0 0 1 8 0v4.3l1.2 1.3H2.8z"/><path d="M6.6 14.3a1.6 1.6 0 0 0 2.8 0"/>',
  bars: '<path d="M3 13.5V9.5M6.5 13.5V5M10 13.5V7.5M13.5 13.5V3"/>',
  spark: '<path d="M8 1.8l1.6 4.6 4.6 1.6-4.6 1.6L8 14.2l-1.6-4.6L1.8 8l4.6-1.6z"/>',
};

const STAGES = [
  { id: 'ingest', stage: 'Ingest', tools: 'NiFi · n8n' },
  { id: 'validate', stage: 'Validate', tools: 'guards · dedup' },
  { id: 'store', stage: 'Unify', tools: 'DCSA events' },
  { id: 'transform', stage: 'Enrich', tools: 'zones · ETA' },
  { id: 'serve', stage: 'Serve', tools: 'PostgreSQL' },
];
const SOURCES = [
  { label: 'carrier APIs', short: 'carriers', glyph: 'ship', tone: 't-amber' },
  { label: 'AIS feeds', short: 'AIS', glyph: 'signal', tone: 't-cyan' },
  { label: 'IoT trackers', short: 'IoT', glyph: 'pin', tone: 't-green' },
  { label: 'emails · docs', short: 'emails', glyph: 'mail', tone: 't-magenta' },
  { label: 'carrier sites', short: 'websites', glyph: 'globe', tone: 't-gray' },
] as const;
const OUTPUTS = [
  { label: 'risk alerts', glyph: 'bell', tone: 't-primary' },
  { label: 'dashboards', glyph: 'bars', tone: 't-primary' },
  { label: 'AI insights', glyph: 'spark', tone: 't-violet' },
] as const;

const line = (a: Pt, b: Pt): [Pt, Pt, Pt, Pt] => [a, [a[0] + (b[0] - a[0]) / 3, a[1] + (b[1] - a[1]) / 3], [a[0] + (2 * (b[0] - a[0])) / 3, a[1] + (2 * (b[1] - a[1])) / 3], b];
const hcurve = (a: Pt, b: Pt): [Pt, Pt, Pt, Pt] => { const m = (a[0] + b[0]) / 2; return [a, [m, a[1]], [m, b[1]], b]; };
const vcurve = (a: Pt, b: Pt): [Pt, Pt, Pt, Pt] => { const m = (a[1] + b[1]) / 2; return [a, [a[0], m], [b[0], m], b]; };

function wide(): Layout {
  const cy = 150, w = 112, h = 52, gap = 150, x0 = 250;
  const boxes: Box[] = STAGES.map((s, i) => ({ ...s, x: x0 + i * gap - w / 2, y: cy - h / 2, w, h, kind: 'stage' }));
  const vx = x0 + gap; // validate centre
  boxes.push({ id: 'quarantine', x: vx - 46, y: 238, w: 92, h: 32, kind: 'quarantine' });
  const sources: Port[] = SOURCES.map((s, i) => ({ id: `src${i}`, cx: 126, cy: 50 + i * 50, lx: 104, ly: 54 + i * 50, anchor: 'end', ...s }));
  const outputs: Port[] = OUTPUTS.map((o, i) => ({ id: `out${i}`, cx: 952, cy: 90 + i * 60, lx: 974, ly: 94 + i * 60, anchor: 'start', ...o }));
  const c = (id: string) => { const b = boxes.find((x) => x.id === id)!; return [b.x + b.w / 2, b.y + b.h / 2] as Pt; };
  const edges: Edge[] = [
    ...sources.map((s) => ({ id: `${s.id}>ingest`, from: s.id, to: 'ingest', p: hcurve([s.cx, s.cy], c('ingest')) })),
    { id: 'ingest>validate', from: 'ingest', to: 'validate', p: line(c('ingest'), c('validate')) },
    { id: 'validate>quarantine', from: 'validate', to: 'quarantine', p: line(c('validate'), c('quarantine')) },
    { id: 'validate>store', from: 'validate', to: 'store', p: line(c('validate'), c('store')) },
    { id: 'store>transform', from: 'store', to: 'transform', p: line(c('store'), c('transform')) },
    { id: 'transform>serve', from: 'transform', to: 'serve', p: line(c('transform'), c('serve')) },
    ...outputs.map((o) => ({ id: `serve>${o.id}`, from: 'serve', to: o.id, p: hcurve(c('serve'), [o.cx, o.cy]) })),
  ];
  return { name: 'wide', w: 1080, h: 300, boxes, sources, outputs, edges, fs: { stage: 11.5, tools: 14.5, port: 13 } };
}

function tall(): Layout {
  const cx = 150, w = 176, h = 46, gap = 72, y0 = 128;
  const boxes: Box[] = STAGES.map((s, i) => ({ ...s, x: cx - w / 2, y: y0 + i * gap - h / 2, w, h, kind: 'stage' }));
  const vy = y0 + gap;
  boxes.push({ id: 'quarantine', x: 266, y: vy - 16, w: 84, h: 32, kind: 'quarantine' });
  const src = SOURCES.slice(0, 4);
  const sources: Port[] = src.map((s, i) => ({ id: `src${i}`, cx: 45 + i * 90, cy: 30, lx: 45 + i * 90, ly: 64, anchor: 'middle', ...s, label: s.short }));
  const oy = y0 + 4 * gap + 74;
  const outputs: Port[] = OUTPUTS.map((o, i) => ({ id: `out${i}`, cx: 60 + i * 90, cy: oy, lx: 60 + i * 90, ly: oy + 32, anchor: 'middle', ...o }));
  const c = (id: string) => { const b = boxes.find((x) => x.id === id)!; return [b.x + b.w / 2, b.y + b.h / 2] as Pt; };
  const edges: Edge[] = [
    ...sources.map((s) => ({ id: `${s.id}>ingest`, from: s.id, to: 'ingest', p: vcurve([s.cx, s.cy], c('ingest')) })),
    { id: 'ingest>validate', from: 'ingest', to: 'validate', p: line(c('ingest'), c('validate')) },
    { id: 'validate>quarantine', from: 'validate', to: 'quarantine', p: line(c('validate'), c('quarantine')) },
    { id: 'validate>store', from: 'validate', to: 'store', p: line(c('validate'), c('store')) },
    { id: 'store>transform', from: 'store', to: 'transform', p: line(c('store'), c('transform')) },
    { id: 'transform>serve', from: 'transform', to: 'serve', p: line(c('transform'), c('serve')) },
    ...outputs.map((o) => ({ id: `serve>${o.id}`, from: 'serve', to: o.id, p: vcurve(c('serve'), [o.cx, o.cy]) })),
  ];
  return { name: 'tall', w: 360, h: oy + 46, boxes, sources, outputs, edges, fs: { stage: 10, tools: 13, port: 11 } };
}

const layouts = [wide(), tall()];
const d = (p: [Pt, Pt, Pt, Pt]) => `M${p[0].join(' ')}C${p[1].join(' ')} ${p[2].join(' ')} ${p[3].join(' ')}`;
const bez = (p: [Pt, Pt, Pt, Pt], t: number): Pt => {
  const u = 1 - t;
  const f = (k: 0 | 1) => u * u * u * p[0][k] + 3 * u * u * t * p[1][k] + 3 * u * t * t * p[2][k] + t * t * t * p[3][k];
  return [f(0), f(1)];
};
// Parked records for the static (no-JS / reduced-motion) picture.
const parked = (l: Layout) =>
  l.edges.flatMap((e, i) => {
    if (e.to === 'quarantine') return [{ pt: bez(e.p, 0.62), cls: 'pk bad' }];
    const row = ['transform>serve', 'serve>out0', 'serve>out1', 'serve>out2'].includes(e.id);
    const ts = e.from.startsWith('src') ? [0.45] : [0.38, 0.72];
    return ts.map((t) => ({ pt: bez(e.p, t), cls: row ? 'pk row' : `pk ${['t-cyan', 't-amber', 't-green', 't-magenta', 't-gray'][i % 5]}` }));
  });
---

<figure class="pipeline card overflow-hidden p-0" data-pipeline aria-labelledby="pipeline-caption">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line px-4 py-3 sm:px-5">
    <div class="flex items-center gap-2.5">
      <span class="relative flex size-2.5">
        <span class="live-ping absolute inline-flex size-full rounded-full bg-green opacity-60"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-green"></span>
      </span>
      <span class="font-mono text-[12.5px] text-fg">pipeline<span class="text-muted">.run()</span></span>
      <span class="rounded border border-line px-1.5 py-px font-mono text-[10.5px] uppercase tracking-wider text-muted">simulation</span>
    </div>
    <dl class="counters m-0 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[12px]">
      <div class="flex gap-1.5"><dt class="text-muted">ingested</dt><dd class="tnum m-0 text-fg" data-count="ingested">0</dd></div>
      <div class="flex gap-1.5"><dt class="text-muted">valid</dt><dd class="tnum m-0 text-green" data-count="valid">100%</dd></div>
      <div class="flex gap-1.5"><dt class="text-muted">quarantined</dt><dd class="tnum m-0 text-red" data-count="quarantined">0</dd></div>
      <div class="hidden gap-1.5 sm:flex"><dt class="text-muted">served</dt><dd class="tnum m-0 text-primary" data-count="served">0</dd></div>
    </dl>
  </div>

  <div class="px-2 py-4 sm:px-4 sm:py-5">
    {layouts.map((l) => (
      <svg
        class:list={['mx-auto block h-auto w-full', l.name === 'wide' ? 'hidden min-[900px]:block' : 'max-w-[400px] min-[900px]:hidden']}
        viewBox={`0 0 ${l.w} ${l.h}`}
        data-layout={l.name}
        role="img"
        aria-label="Freshtrack data flow: carrier APIs, AIS feeds, IoT trackers, emails and documents, and carrier websites are ingested with NiFi and n8n, validated (records that fail a guard go to quarantine), unified into one event model, enriched with zones and ETAs, served from PostgreSQL, and turned into risk alerts, dashboards and AI insights."
      >
        <g class="edges">
          {l.edges.map((e) => <path id={`${l.name}-${e.id}`} data-edge={e.id} d={d(e.p)} class:list={['edge', e.to === 'quarantine' && 'edge-bad']} />)}
        </g>
        <g class="parked">
          {parked(l).map((p) => <circle cx={p.pt[0].toFixed(1)} cy={p.pt[1].toFixed(1)} r="3.5" class={p.cls} />)}
        </g>
        <g class="particles" data-particles></g>
        <g class="nodes">
          {l.boxes.map((b) => (
            <g data-node={b.id} class:list={['node', b.kind === 'quarantine' && 'node-q']}>
              <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.kind === 'quarantine' ? 8 : 11} class="node-box" />
              <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.kind === 'quarantine' ? 8 : 11} class="node-glow" data-glow={b.id} />
              {b.kind === 'stage' ? (
                <>
                  <text x={b.x + b.w / 2} y={b.y + b.h / 2 - 5} text-anchor="middle" class="t-stage" font-size={l.fs.stage}>{b.stage!.toUpperCase()}</text>
                  <text x={b.x + b.w / 2} y={b.y + b.h / 2 + l.fs.tools - 1} text-anchor="middle" class="t-tools" font-size={l.fs.tools}>{b.tools}</text>
                </>
              ) : (
                <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 4} text-anchor="middle" class="t-quarantine" font-size={l.fs.stage}>
                  quarantine <tspan data-q-count>0</tspan>
                </text>
              )}
            </g>
          ))}
          {[...l.sources, ...l.outputs].map((p) => (
            <g data-node={p.id} class:list={['port', p.tone]}>
              <rect x={p.cx - 15} y={p.cy - 15} width="30" height="30" rx="8" class="node-box" />
              <rect x={p.cx - 15} y={p.cy - 15} width="30" height="30" rx="8" class="node-glow" data-glow={p.id} />
              <g transform={`translate(${p.cx - 8} ${p.cy - 8})`} class="glyph" set:html={glyphs[p.glyph]} />
              <text x={p.lx} y={p.ly} text-anchor={p.anchor} class="t-port" font-size={l.fs.port}>{p.label}</text>
            </g>
          ))}
        </g>
      </svg>
    ))}
  </div>

  <figcaption id="pipeline-caption" class="m-0 flex flex-wrap items-center gap-x-5 gap-y-1.5 border-t border-line px-4 py-3 font-mono text-[11.5px] text-muted sm:px-5">
    <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-full bg-cyan"></span>raw record</span>
    <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px] bg-primary"></span>modelled row</span>
    <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-full bg-red"></span>failed a check → quarantine</span>
    <span class="ml-auto hidden md:inline">A simulation of how signals flow through Freshtrack</span>
  </figcaption>
</figure>

<style is:global>
  .pipeline { --magenta: color-mix(in srgb, var(--red) 55%, var(--violet)); }
  .pipeline .edge { fill: none; stroke: var(--line-strong); stroke-width: 1.3; }
  .pipeline .edge-bad { stroke: color-mix(in srgb, var(--red) 45%, var(--line-strong)); stroke-dasharray: 3 4; }

  .pipeline .node-box { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.2; }
  .pipeline .node-glow { fill: none; stroke: var(--primary); stroke-width: 2; opacity: 0; }
  .pipeline .node-q .node-box { fill: color-mix(in srgb, var(--red) 6%, var(--surface)); stroke: color-mix(in srgb, var(--red) 45%, var(--line)); stroke-dasharray: 4 3; }
  .pipeline .node-q .node-glow { stroke: var(--red); }
  .pipeline .port.t-violet .node-glow { stroke: var(--violet); }

  .pipeline .t-stage { fill: var(--muted); font-family: var(--font-mono); letter-spacing: .12em; }
  .pipeline .t-tools { fill: var(--text); font-family: var(--font-sans); font-weight: 500; }
  .pipeline .t-port { fill: var(--text-2); font-family: var(--font-mono); }
  .pipeline .t-quarantine { fill: var(--red); font-family: var(--font-mono); }

  .pipeline .glyph { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .pipeline .t-violet .glyph { fill: currentColor; stroke: none; }

  .pipeline .t-cyan { color: var(--cyan); fill: var(--cyan); }
  .pipeline .t-amber { color: var(--amber); fill: var(--amber); }
  .pipeline .t-green { color: var(--green); fill: var(--green); }
  .pipeline .t-magenta { color: var(--magenta); fill: var(--magenta); }
  .pipeline .t-gray { color: var(--muted); fill: var(--muted); }
  .pipeline .t-primary { color: var(--primary); fill: var(--primary); }
  .pipeline .t-violet { color: var(--violet); fill: var(--violet); }

  .pipeline .pk { opacity: .9; }
  .pipeline .pk.row, .pipeline .rec.row { fill: var(--primary); }
  .pipeline .pk.bad, .pipeline .rec.bad { fill: var(--red); }
  .pipeline .rec { transition: fill .25s; }

  .pipeline.is-live .parked { display: none; }
  .pipeline:not(.is-live) .counters { visibility: hidden; }

  .pipeline .live-ping { animation: ping 1.8s cubic-bezier(0, 0, .2, 1) infinite; }
  @keyframes ping { 75%, 100% { transform: scale(2.2); opacity: 0; } }
</style>

<script>
  type LUT = { id: string; to: string; len: number; pts: Float32Array; step: number };
  type Rec = { el: SVGRectElement; route: LUT[]; i: number; d: number; speed: number; bad: boolean; out: string };

  const NS = 'http://www.w3.org/2000/svg';
  const TONES = ['t-cyan', 't-amber', 't-green', 't-magenta', 't-gray'];
  const fmt = new Intl.NumberFormat('en-US');

  class Sim {
    private edges = new Map<string, LUT>();
    private glows = new Map<string, { el: Element; last: number }>();
    private recs: Rec[] = [];
    private layer: SVGGElement;
    private qCount: SVGTSpanElement | null;
    private sources: string[];
    private acc = 0;
    private gap = 0.1;

    private ready = false;

    constructor(public svg: SVGSVGElement, private counts: Record<string, number>) {
      this.layer = svg.querySelector('[data-particles]')!;
      this.qCount = svg.querySelector('[data-q-count]');
      this.sources = [];
    }

    /** Sample each path once, only when this layout is actually on screen. */
    private build() {
      const svg = this.svg;
      svg.querySelectorAll<SVGPathElement>('[data-edge]').forEach((p) => {
        const id = p.dataset.edge!;
        const len = p.getTotalLength();
        const step = 3;
        const n = Math.max(2, Math.ceil(len / step));
        const pts = new Float32Array((n + 1) * 2);
        for (let k = 0; k <= n; k++) {
          const pt = p.getPointAtLength((len * k) / n);
          pts[k * 2] = pt.x;
          pts[k * 2 + 1] = pt.y;
        }
        this.edges.set(id, { id, to: id.split('>')[1], len, pts, step: len / n });
      });
      svg.querySelectorAll('[data-glow]').forEach((el) => this.glows.set((el as SVGElement).dataset.glow!, { el, last: 0 }));
      this.sources = [...this.edges.keys()].filter((k) => k.startsWith('src')).map((k) => k.split('>')[0]);
      this.ready = true;
    }

    get visible() { return this.svg.getBoundingClientRect().width > 0; }

    private spawn() {
      if (this.recs.length > 140) return;
      const src = this.sources[Math.floor(Math.random() * this.sources.length)];
      const bad = Math.random() < 0.03;
      const r = Math.random();
      const out = r < 0.42 ? 'out0' : r < 0.74 ? 'out1' : 'out2';
      const names = [`${src}>ingest`, 'ingest>validate', ...(bad ? ['validate>quarantine'] : ['validate>store', 'store>transform', 'transform>serve', `serve>${out}`])];
      const route = names.map((n) => this.edges.get(n)!).filter(Boolean);
      const el = document.createElementNS(NS, 'rect') as SVGRectElement;
      el.setAttribute('width', '7');
      el.setAttribute('height', '7');
      el.setAttribute('rx', '3.5');
      el.setAttribute('class', `rec ${TONES[Number(src.slice(3)) % TONES.length]}`);
      this.layer.appendChild(el);
      this.recs.push({ el, route, i: 0, d: 0, speed: 120 + Math.random() * 50, bad, out });
    }

    private pulse(id: string, now: number) {
      const g = this.glows.get(id);
      if (!g || now - g.last < 140) return;
      g.last = now;
      g.el.animate([{ opacity: 0.9 }, { opacity: 0 }], { duration: 650, easing: 'cubic-bezier(.2,.7,.2,1)' });
    }

    private arrive(rec: Rec, node: string, now: number) {
      this.pulse(node, now);
      if (node === 'ingest') this.counts.ingested++;
      else if (node === 'validate' && rec.bad) rec.el.classList.add('bad');
      else if (node === 'quarantine') {
        this.counts.quarantined++;
        if (this.qCount) this.qCount.textContent = fmt.format(this.counts.quarantined);
      } else if (node === 'transform') {
        rec.el.classList.add('row');
        rec.el.setAttribute('rx', '1.6');
        rec.el.setAttribute('width', '8');
        rec.el.setAttribute('height', '8');
      } else if (node === 'serve') this.counts.served++;
    }

    step(dt: number, now: number, warming = false) {
      if (!this.ready) this.build();
      this.acc += dt;
      while (this.acc > this.gap) {
        this.acc -= this.gap;
        this.spawn();
        this.gap = 0.045 + Math.random() * 0.09;
      }
      for (const rec of this.recs) {
        rec.d += rec.speed * dt;
        let e = rec.route[rec.i];
        while (e && rec.d >= e.len) {
          rec.d -= e.len;
          this.arrive(rec, e.to, now);
          e = rec.route[++rec.i];
        }
        if (!e) {
          if (warming) rec.el.remove();
          else rec.el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 260 }).onfinish = () => rec.el.remove();
          continue;
        }
        const k = Math.min(Math.floor(rec.d / e.step), e.pts.length / 2 - 1);
        const size = rec.el.classList.contains('row') ? 4 : 3.5;
        rec.el.setAttribute('x', (e.pts[k * 2] - size).toFixed(1));
        rec.el.setAttribute('y', (e.pts[k * 2 + 1] - size).toFixed(1));
      }
      this.recs = this.recs.filter((r) => r.i < r.route.length);
    }

    /** Pre-fill the pipeline so it looks busy from the first frame. */
    warm(seconds: number) {
      if (this.warmed) return;
      this.warmed = true;
      // Counts from the warm-up are kept, so the stats are already meaningful on the first frame.
      for (let t = 0; t < seconds; t += 1 / 30) this.step(1 / 30, -1e9, true);
      if (this.qCount) this.qCount.textContent = fmt.format(this.counts.quarantined);
    }
    private warmed = false;
  }

  function init(root: HTMLElement) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return;
    const counts = { ingested: 0, quarantined: 0, served: 0 };
    const sims = [...root.querySelectorAll<SVGSVGElement>('svg[data-layout]')].map((svg) => new Sim(svg, counts));
    const out = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-count]')].map((el) => [el.dataset.count!, el]));
    let inView = false;
    let raf = 0;
    let last = 0;
    let lastUi = 0;

    const active = () => {
      const sim = sims.find((s) => s.visible);
      sim?.warm(12);
      return sim;
    };
    const render = () => {
      out.ingested.textContent = fmt.format(counts.ingested);
      out.quarantined.textContent = fmt.format(counts.quarantined);
      out.served.textContent = fmt.format(counts.served);
      const valid = counts.ingested ? ((counts.ingested - counts.quarantined) / counts.ingested) * 100 : 100;
      out.valid.textContent = `${valid.toFixed(1)}%`;
    };
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      active()?.step(dt, now);
      if (now - lastUi > 200) { render(); lastUi = now; }
      raf = requestAnimationFrame(frame);
    };
    const start = () => {
      if (raf || !inView || document.hidden) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    active();
    root.classList.add('is-live');
    render();

    new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; inView ? start() : stop(); }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduced.addEventListener('change', () => { if (reduced.matches) stop(); });
  }

  document.querySelectorAll<HTMLElement>('[data-pipeline]').forEach(init);
</script>
